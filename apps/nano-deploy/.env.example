APP_ENV=production

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
AUTH_USERNAME=admin
AUTH_PASSWORD=change-this-password
AUTH_TOKEN=change-this-ui-token

# Agent location
BOARD_SCHEME=http
BOARD_HOST=
BOARD_PORT=9001
# If Dashboard and Agent are on different Tailscale nodes, set this to the Agent's Tailscale IP or MagicDNS name.
TAILSCALE_HOST=
AGENT_TOKEN=change-this-agent-token
BOARD_NAME=jetson-nano

# Camera and stream
CAMERA_RTSP_VISIBLE_URL=
CAMERA_RTSP_IR_URL=
# Compatibility fallback. New deployments should use CAMERA_RTSP_VISIBLE_URL.
CAMERA_RTSP_URL=
# Agent-side sparse capture process and manifest store.
CAPTURE_SCRIPT=/home/nvidia/carmove/tools/collect_rtsp_frames.py
CAPTURE_WORKDIR=/home/nvidia/carmove
CAPTURE_OUTPUT_ROOT=/home/nvidia/carmove/datasets/local/roadside_v1
CAPTURE_PYTHON_BIN=/home/nvidia/Desktop/wheeltec_ros2/shijue/Nano_Deploy/.venv/bin/python
# Battery is read-only. This pack is calibrated as 22.6V full and 20.0V safe lower bound.
BATTERY_ENABLED=true
BATTERY_VOLTAGE_TOPIC=/PowerVoltage
BATTERY_CHARGING_TOPIC=/robot_charging_flag
BATTERY_CURRENT_TOPIC=/robot_charging_current
BATTERY_ROS_SETUP_BASH=/opt/ros/humble/setup.bash
BATTERY_PYTHON_BIN=python3
BATTERY_STALE_SECONDS=10
BATTERY_EMPTY_VOLTAGE=20.0
BATTERY_FULL_VOLTAGE=22.6
BATTERY_LOW_VOLTAGE=20.0
BATTERY_LOW_PERCENTAGE=20
BATTERY_FILTER_WINDOW=5
BATTERY_LOW_CONFIRM_SAMPLES=3
# When the full chassis ROS driver is stopped, use this read-only UART reader.
BATTERY_DIRECT_SERIAL_ENABLED=true
BATTERY_SERIAL_PORT=/dev/ttyCH343USB0
BATTERY_SERIAL_BAUDRATE=115200
SIYI_ZT6_ENABLED=true
SIYI_ZT6_HOST=
SIYI_ZT6_PORT=37260
SIYI_ZT6_QUERY_TIMEOUT_SECONDS=1.0
# Keep disabled until you explicitly approve live Dashboard gimbal control.
SIYI_ZT6_MOTION_ENABLED=false
SIYI_ZT6_MOTION_MAX_SPEED=10
SIYI_ZT6_MOTION_MAX_DURATION_MS=500
ALLOW_MJPEG_FALLBACK=false
WEBRTC_ICE_SERVERS=["stun:stun.l.google.com:19302"]
WEBRTC_OUTPUT_WIDTH=960
WEBRTC_OUTPUT_HEIGHT=540
WEBRTC_OUTPUT_FPS=12
WEBRTC_PREFERRED_CODEC=H264
WEBRTC_STALE_FRAME_MS=1500

# Detection runtime
MODEL_WORKDIR=/home/nvidia/Desktop/wheeltec_ros2/shijue/Nano_Deploy
MODEL_VENV_ACTIVATE=/home/nvidia/Desktop/wheeltec_ros2/shijue/Nano_Deploy/.venv/bin/activate
MODEL_PYTHON_BIN=/home/nvidia/Desktop/wheeltec_ros2/shijue/Nano_Deploy/.venv/bin/python
MODEL_SCRIPT=nano_rtsp_detect.py
MODEL_DEFAULT_SOURCE=
MODEL_DEFAULT_VID_STRIDE=5
MODEL_DEFAULT_IMG_SIZE=640
MODEL_DEFAULT_CONF=0.4
MODEL_DEFAULT_IOU=0.5
MODEL_DEFAULT_DEVICE=
MODEL_DEFAULT_HALF=false
MODEL_EXTRA_ARGS=[]
MODEL_SNAPSHOT_INTERVAL=0.1
MODEL_SNAPSHOT_MAX_SIZE=960
AVAILABLE_MODELS=[{"id":"helmet","label":"Helmet","weight":"helmet.pt"},{"id":"fall","label":"Fall","weight":"fall.pt"},{"id":"smoke","label":"Smoke","weight":"smoke.pt"},{"id":"danger","label":"Danger","weight":"danger.pt"}]

# Whitelisted control commands. Keep these as safe placeholders until you provide the real chassis command set.
CONTROL_COMMAND_MAP={"forward":["bash","-lc","echo CONTROL_PLACEHOLDER forward speed={speed}"],"backward":["bash","-lc","echo CONTROL_PLACEHOLDER backward speed={speed}"],"left":["bash","-lc","echo CONTROL_PLACEHOLDER left speed={speed}"],"right":["bash","-lc","echo CONTROL_PLACEHOLDER right speed={speed}"],"stop":["bash","-lc","echo CONTROL_PLACEHOLDER stop"]}

# Template only. Do not enable until you confirm the actual board control commands.
# Example shape:
# CONTROL_COMMAND_MAP_REAL_EXAMPLE={"forward":["bash","-lc","/path/to/robot_ctl --linear {speed}"],"backward":["bash","-lc","/path/to/robot_ctl --linear -{speed}"],"left":["bash","-lc","/path/to/robot_ctl --angular {speed}"],"right":["bash","-lc","/path/to/robot_ctl --angular -{speed}"],"stop":["bash","-lc","/path/to/robot_ctl --stop"]}

# Safe motion bridge. Keep this locked and in dry-run mode until the vehicle is lifted or the test area is confirmed safe.
ENABLE_MOTION_CONTROL=false
MOTION_CONTROL_MODE=dry_run
CMD_VEL_TOPIC=/cmd_vel_nav
MAX_LINEAR_VEL_SAFE=0.05
MAX_ANGULAR_VEL_SAFE=0.20
CONTROL_COMMAND_TIMEOUT_MS=300
REQUIRE_MANUAL_ARM=true
DISABLE_MANUAL_WHEN_NAV_RUNNING=true
BASE_START_SCRIPT=/home/nvidia/Desktop/wheeltec_ros2/start_base.sh
BASE_CMD_VEL_TOPIC=/cmd_vel_nav
BASE_ODOM_TOPIC=/odom
BASE_NODE_NAME=/wheeltec_robot
BASE_BRINGUP_START_TIMEOUT_SECONDS=18
BASE_STATUS_TIMEOUT_SECONDS=8
STATUS_CACHE_SECONDS=2.0
WEBSOCKET_STATUS_INTERVAL=3.0

# Media capture and gallery
RECORDING_ENABLED=true
RECORDING_WORKDIR=/home/nvidia/video_rec
RECORDING_OUTPUT_DIR=/home/nvidia/video_rec/rec
SNAPSHOT_OUTPUT_DIR=dashboard_platform/runtime/media/snapshots
GALLERY_ENABLED=true
GALLERY_PAGE_SIZE=20
RECORDING_USE_LEGACY_WEB_RECORDER=false
RECORDING_USE_FFMPEG_DIRECT=true
DEV_SCREEN_RECORDING_ENABLED=true
DEV_SCREEN_RECORDING_BACKEND=auto
DEV_SCREEN_RECORDING_OUTPUT_DIR=dashboard_platform/runtime/media/screen_recordings
DEV_SCREEN_RECORDING_FPS=10
DEV_SCREEN_RECORDING_WIDTH=1280
DEV_SCREEN_RECORDING_HEIGHT=720
DEV_SCREEN_RECORDING_DISPLAY=
DEV_SCREEN_RECORDING_XAUTHORITY=
DEV_SCREEN_RECORDING_BITRATE_KBPS=1800
DEV_SCREEN_RECORDING_SHOW_POINTER=true
DEV_SCREEN_RECORDING_USE_DAMAGE=false

# Maps and nav workflow
MAPS_DIRECTORY=/home/nvidia/Desktop/wheeltec_ros2/maps
DEFAULT_MAP_NAME=gmap_map

# Preset commands. Long-running mapping/navigation/RViz actions are launched in background.
PRESET_COMMANDS={"start_mapping":["internal:spawn","bash","scripts/start_mapping_integrated.sh"],"save_map":["bash","scripts/save_map.sh","{map_name}"],"start_navigation":["internal:spawn","bash","scripts/start_navigation_integrated.sh","{map_name}"],"open_rviz":["internal:spawn","bash","-lc","source /opt/ros/humble/setup.bash && rviz2 -d /opt/ros/humble/share/nav2_bringup/rviz/nav2_default_view.rviz"],"stop_mapping":["bash","scripts/start_mapping_integrated.sh","stop"],"stop_navigation":["bash","scripts/start_navigation_integrated.sh","stop"],"stop_all":["internal:stop_model"]}

# ROS2 sensor bridge
LIDAR_ENABLED=true
LIDAR_IP=
LIDAR_MSOP_PORT=2363
LIDAR_DIFOP_PORT=2364
LIDAR_POINT_TOPIC=/c16/lslidar_point_cloud
IMU_ENABLED=true
IMU_TOPIC=/imu/data
IMU_RAW_TOPIC=/imu/data_raw
ROS2_LIDAR_SETUP_BASH=/home/nvidia/fastlio2_ws/install/setup.bash
ROS2_IMU_SETUP_BASH=/home/nvidia/serial-ros2/install/setup.bash;/home/nvidia/imu-driver/ROS2 SDK/yesense_ros2/install/setup.bash
ROS2_BRIDGE_PYTHON_BIN=python3
SENSOR_BRIDGE_ENABLED=false
POINTCLOUD_MAX_POINTS=600
POINTCLOUD_SEND_HZ=5
POINTCLOUD_KEEP_SECONDS=1.0
LIDAR_TO_BASE_TRANSLATION=[0.0,0.0,0.0]
LIDAR_TO_BASE_ROTATION_RPY=[0.0,0.0,0.0]
IMU_TO_BASE_ROTATION_RPY=[0.0,0.0,0.0]
ROBOT_POSE_ENABLED=true
ROBOT_POSE_MAP_FRAME=map
ROBOT_POSE_BASE_FRAME=base_footprint
ROBOT_POSE_FALLBACK_BASE_FRAME=base_link
ROBOT_POSE_AMCL_TOPIC=/amcl_pose
CAR_MODEL_FORWARD_AXIS=positive_z
CAR_MODEL_UP_AXIS=positive_y
POINTCLOUD_HISTORY_SECONDS=0.75
