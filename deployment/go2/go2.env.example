# Go2 first-stage data-only profile. Copy to go2.env and fill local secrets.
APP_ENV=production
BOARD_NAME=unitree-go2
DEVICE_PROFILE=unitree_go2
GO2_DATA_ONLY=true

# Dashboard server and local Agent bridge
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
AUTH_USERNAME=admin
AUTH_PASSWORD=replace-with-a-local-password
AUTH_TOKEN=replace-with-a-long-random-ui-token
BOARD_SCHEME=http
BOARD_HOST=127.0.0.1
BOARD_PORT=9001
AGENT_TOKEN=replace-with-a-long-random-agent-token
# Filled only after Tailscale authentication; leave blank for local Agent access.
TAILSCALE_HOST=
FRONTEND_DIST_DIR=/home/unitree/go2move/apps/nano-deploy/dashboard_platform/web/dist

# Source is deliberately a local MP4 until a Go2 camera source is verified.
# OpenCV accepts local files, USB indexes, and verified URLs through this field.
CAMERA_RTSP_VISIBLE_URL=/home/unitree/go2move/runtime/testdata/go2_offline_test.mp4
CAMERA_RTSP_IR_URL=
CAMERA_RTSP_URL=/home/unitree/go2move/runtime/testdata/go2_offline_test.mp4
MODEL_DEFAULT_SOURCE=/home/unitree/go2move/runtime/testdata/go2_offline_test.mp4
CAMERA_SOURCE_TYPE=opencv
CAMERA_SOURCE_LABEL=offline_mp4_test
CAMERA_LIVE_CONFIRMED=false
IR_CAMERA_ENABLED=false
CAPTURE_SCRIPT=/home/unitree/go2move/tools/collect_rtsp_frames.py
CAPTURE_WORKDIR=/home/unitree/go2move
CAPTURE_OUTPUT_ROOT=/home/unitree/go2move/runtime/data
CAPTURE_PYTHON_BIN=/home/unitree/go2move/.venv/bin/python

# No model, recording, screen recording, or hardware sensor bridge in stage 1.
MODEL_WORKDIR=/home/unitree/go2move
MODEL_PYTHON_BIN=/home/unitree/go2move/.venv/bin/python
MODEL_VENV_ACTIVATE=/home/unitree/go2move/.venv/bin/activate
MODEL_SCRIPT=/home/unitree/go2move/apps/nano-deploy/nano_rtsp_detect.py
AVAILABLE_MODELS=[]
RECORDING_ENABLED=false
RECORDING_WORKDIR=/home/unitree/go2move/runtime/recording
RECORDING_OUTPUT_DIR=/home/unitree/go2move/runtime/recording/rec
DEV_SCREEN_RECORDING_ENABLED=false
GALLERY_ENABLED=true
ALLOW_MJPEG_FALLBACK=false
WEBRTC_ICE_SERVERS=[]
SNAPSHOT_OUTPUT_DIR=/home/unitree/go2move/runtime/media/snapshots
PID_FILE=/home/unitree/go2move/runtime/model.pid
MAPS_DIRECTORY=/home/unitree/go2move/runtime/disabled_maps
EVENTS_DIRECTORY=/home/unitree/go2move/runtime/events

# Explicit hardware safety switches.
ENABLE_MOTION_CONTROL=false
MOTION_CONTROL_MODE=dry_run
ROBOT_POSE_ENABLED=false
LIDAR_ENABLED=false
# Future sensor phase: prefer the back-mounted Hesai XT over any built-in
# Go2 lidar. Keep both disabled until the physical link and live packets are
# verified; this stage does not start a lidar driver.
LIDAR_PRIMARY_SOURCE=hesai_xt
GO2_BUILTIN_LIDAR_ENABLED=false
HESAI_ENABLED=false
HESAI_DEVICE_IP=
HESAI_UDP_PORT=2368
HESAI_PTC_PORT=9347
HESAI_POINT_TOPIC=/hesai_xt/points
HESAI_ROS2_SETUP_BASH=/home/unitree/hesai_ros2_ws/install/setup.bash
HESAI_CONFIG_PATH=
IMU_ENABLED=false
SENSOR_BRIDGE_ENABLED=false
BATTERY_ENABLED=false
BATTERY_DIRECT_SERIAL_ENABLED=false
SIYI_ZT6_ENABLED=false
SIYI_ZT6_MOTION_ENABLED=false
CONTROL_COMMAND_MAP={}
PRESET_COMMANDS={}
BASE_START_SCRIPT=/home/unitree/go2move/deployment/go2/disabled-wheeltec-start.sh
BASE_CMD_VEL_TOPIC=/disabled/cmd_vel
BASE_NODE_NAME=/disabled

# The following values are inert because the corresponding features are off.
ROS2_LIDAR_SETUP_BASH=
ROS2_IMU_SETUP_BASH=
LIDAR_POINT_TOPIC=/hesai_xt/points
IMU_TOPIC=/disabled/imu
